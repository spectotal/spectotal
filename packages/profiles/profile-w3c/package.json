{
  "name": "@spectotal/profile-w3c",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "schema:generate": "pnpm exec tsx scripts/generate-schema-artifacts.ts",
    "schema:check": "pnpm exec tsx scripts/generate-schema-artifacts.ts --check",
    "test": "pnpm --filter @spectotal/ast-schema build && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@spectotal/ast": "workspace:*",
    "@spectotal/ast-schema": "workspace:*",
    "@spectotal/source-compose": "workspace:*",
    "hast-util-from-html": "^2.0.3",
    "mdast-util-from-markdown": "^2.0.3",
    "@spectotal/profile-core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
